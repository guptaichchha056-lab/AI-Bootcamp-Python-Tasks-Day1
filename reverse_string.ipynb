   "source": [
    "s= \"Hello World\"\n",
    "#Print string in reverse order\n",
    "for i in range(len(s)-1,-1,-1):\n",
    "    print(s[i],end=\"\")\n",
    "print()\n",
    "#Reverse the words of string\n",
    "word= s.split()\n",
    "for i in range(len(word)-1,-1,-1):\n",
    "    print(word[i],end=\" \")"
   ]
  }
